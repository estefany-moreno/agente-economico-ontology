# Plantilla de variables de entorno (plan seccion 6).
# Copiar a .env y rellenar valores reales en local.
# Nunca subir .env al repositorio (esta en .gitignore).
# No poner tokens reales en este archivo.

# APIs de datos macroeconomicos
INEGI_TOKEN=
BANXICO_TOKEN=

# API de noticias (recoleccion; el agente lee Sheets, no esta key en runtime tipico)
DATABURSATIL_TOKEN=

# Google Sheets (cuenta de servicio): ruta al JSON local
GOOGLE_APPLICATION_CREDENTIALS=./secrets/credentials.json
# ID del spreadsheet (placeholder; valor real solo en .env)
SHEET_KEY=

# Proveedor LLM del agente: groq | gemini | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Respaldo automatico si GROQ_MODEL agota su cuota (vacio = sin respaldo)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=

# Control de consumo del LLM (opcionales)
# Tope de llamadas al modelo por pregunta
MAX_LLM_CALLS=5
# Reintentos HTTP del cliente LLM ante 429/5xx
LLM_MAX_RETRIES=2
# Horas que una serie de INEGI/Banxico se reutiliza antes de volver a descargarla
SERIES_TTL_HORAS=6
