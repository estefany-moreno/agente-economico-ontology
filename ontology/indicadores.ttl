ae:perteneceABloque a rdf:Property ;
    rdfs:label "Indicador pertenece a un bloque tematico"@es .

ae:relacionadoCon a rdf:Property ;
    rdfs:label "Relacion economica entre indicadores (arista para OntoRank)"@es .

ae:unidad a rdf:Property ;
    rdfs:label "Unidad de medida o descripcion corta"@es .

